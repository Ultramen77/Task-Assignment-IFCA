# Set this to the GitHub Pages base path for production builds.
# Example for a repo named "Task-Assigment": /Task-Assigment/
VITE_BASE_PATH=/

# Data source: 'mock' | 'supabase'
VITE_DATA_SOURCE=mock

# Supabase (when VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sheets mirror — 1 arah Web → Sheets FULL API (tanpa Apps Script)
# Edge Function URL (default: <SUPABASE_URL>/functions/v1/sync-to-sheets)
# Kosongkan untuk pakai default. Isi custom jika self-host.
VITE_SHEETS_SYNC_URL=
# Optional shared secret forwarded as x-sheets-sync-token — must match SHEETS_SYNC_TOKEN on Edge Function
VITE_SHEETS_SYNC_TOKEN=

# Legacy — deprecated (Apps Script mode, tidak dipakai lagi)
# VITE_API_URL=

# Migration-only credentials. These are read by scripts, never by the browser.
# Keep the real values in .env.local and never commit that file.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
TARGET_DATABASE_URL=postgresql://user:password@host:port/database?sslmode=disable
