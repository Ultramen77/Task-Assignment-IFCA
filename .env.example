# Set this to the GitHub Pages base path for production builds.
# Example for a repo named "Task-Assigment": /Task-Assigment/
VITE_BASE_PATH=/

# Data source: 'mock' | 'postgres'
VITE_DATA_SOURCE=postgres

# PostgreSQL API URL (the Express server, for example http://localhost:3001/api/data)
VITE_API_URL=

# Public origin used by the server when it builds attachment URLs.
# Keep this server-side value aligned with the API/reverse-proxy URL in production.
PUBLIC_API_URL=http://localhost:3001

# Migration-only Supabase credentials. These are read by migration scripts, never by the browser.
# Keep the real values in .env.local and never commit that file.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
TARGET_DATABASE_URL=postgresql://user:password@host:port/database?sslmode=disable

# Better Auth server (keep real values in .env.local or server environment)
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
AUTH_PORT=3001
AUTH_DB_POOL_MAX=5
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL for the auth server. Leave empty when using a same-origin reverse proxy.
VITE_AUTH_URL=http://localhost:3001

# SMTP is required for the self-service "forgot password" email flow.
# Admins can still reset a user's password from the Admin page without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Office FTP attachment storage. Keep these server-only; never use a VITE_ prefix.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_ROOT_DIR=/task-assignment/attachments
FTP_SECURE=false
